{
  "manifest_version": 3,
  "name": "Screentime",
  "version": "0.3.0",
  "description": "Hide distracting feeds and buttons, set daily website limits, and choose allowed time windows.",
  "permissions": ["storage", "tabs", "idle", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "action": {
    "default_title": "Screentime",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "116",
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
